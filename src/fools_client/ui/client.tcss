Screen {
    align: center top;
}

.form, .detail, .browser {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

.form {
    max-width: 90;
}

.heading {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

Static, Label {
    height: auto;
    width: 1fr;
}

Input, Select {
    margin-bottom: 1;
}

.rules {
    height: auto;
}

Checkbox {
    width: 1fr;
}

.actions {
    grid-size: 3;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: 3;
    grid-gutter: 1;
    height: auto;
    margin: 1 0;
}

Button {
    width: 1fr;
    min-width: 0;
}

.connection {
    color: $text-muted;
    margin-bottom: 1;
}

.muted {
    color: $text-muted;
}

.warning {
    color: $warning;
    margin: 1 0;
}

#notice {
    min-height: 1;
    margin: 1 0;
}

#notice.error {
    color: $error;
}

#lobbies {
    height: 1fr;
    min-height: 5;
}

#player-art, #pile-art {
    height: auto;
    margin: 1 0;
}

#pile-art {
    width: 1fr;
    align-horizontal: center;
    align-vertical: middle;
}

.pile-item {
    width: auto;
    height: 7;
    margin: 0 1;
}

.card-board {
    width: 1fr;
    height: 12;
    min-height: 10;
    padding: 1;
    border: round $warning;
    margin-bottom: 1;
}

#board-cards {
    align-horizontal: center;
}

#hand-cards {
    height: 11;
    min-height: 9;
    padding: 1;
    align-horizontal: center;
    border: round $accent;
    margin-bottom: 1;
}

.game-card {
    width: 11;
    height: 7;
    margin: 0 1;
}

.game-card.selected {
    width: 15;
    height: 9;
}

.trick-row {
    width: 1fr;
    layers: cards defense;
    height: 9;
    align: center middle;
    margin: 0 1 0 0;
}

.trick-row > .game-card {
    layer: cards;
}

.table-card {
    layer: defense;
    width: auto;
    height: auto;
    margin: 0 1;
    offset: 5 -1;
    background: $surface;
}

.card-arrow, .empty-board {
    width: auto;
    height: auto;
    margin: 0 1;
}

#chat {
    height: 10;
    margin: 1 0;
}

#chat {
    height: 12;
}

.game-actions {
    grid-size: 4;
    grid-columns: 1fr 1fr 1fr 1fr;
}

.chat-entry {
    height: auto;
    width: 1fr;
    align: left middle;
}

.chat-entry Input {
    width: 1fr;
}

.chat-entry Button {
    width: auto;
    min-width: 14;
}

#confirmation {
    display: none;
    height: auto;
    border: round $warning;
    padding: 0 1;
}
